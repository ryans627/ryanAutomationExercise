{
  "name": "interview_framework",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.21.1",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.21.0",
    "@wdio/mocha-framework": "^9.21.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.46.1",
    "expect-webdriverio": "^5.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "wdio:headless": "HEADLESS=1 wdio run ./wdio.conf.ts",
    "wdio:seq": "MAX_INSTANCES=1 wdio run ./wdio.conf.ts",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:report": "npm run wdio:headless; npm run report"
  }
}
